{
  "type": "record",
  "name": "Order",
  "namespace": "com.ecommerce.app",
  "fields": [
    {
      "name": "order_id",
      "type": {
        "type": "string",
        "arg.properties": {
          "regex": "ORD-[0-9]{5}"
        }
      }
    },
    {
      "name": "user_id",
      "type": {
        "type": "string",
        "arg.properties": {
          "regex": "USER-[0-9]{3}"
        }
      }
    },
    {
      "name": "amount",
      "type": {
        "type": "double",
        "arg.properties": {
          "range": {
            "min": 10.0,
            "max": 999.0
          }
        }
      }
    }
  ]
}
